# Qist Customer Android App Configuration Example

# Backend API URL (customer-app endpoints)
CUSTOMER_API_URL=https://qist.restora.live/api/v1/customer-app/
API_URL=https://qist.restora.live/api/v1/

# Keystore signing credentials
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Optional local keystore path (if not using base64)
# ANDROID_KEYSTORE_FILE=../qist-release.jks
